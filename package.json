{
  "name": "simple2d",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "scripts": {
    "prebuild": "rimraf dist",
    "copy-resources": "copyfiles --up 1 \"src/resources/**/*\" dist/",
    "build:server": "npx tsc -build ./src",
    "build:client": "npx parcel build ./src/public/index.html --dist-dir \"dist/public\"",
    "build": "npm run prebuild && npm run build:server && npm run build:client && npm run copy-resources",
    "start": "node ./dist",
    "dev": "npm run build && npm run start"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.2"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "express": "^5.2.1",
    "fs-extra": "^11.3.2",
    "onnxruntime-node": "^1.23.2",
    "rimraf": "^6.1.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "svgson": "^5.3.1",
    "typescript": "^5.9.3"
  },
  "ts-standard": {
    "project": "src/tsconfig.json",
    "ignore": [
      "dist"
    ]
  }
}